{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".test-build",
    "noEmitOnError": false,
    "composite": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*",
    "*.spec.ts",
    "src/__tests__/**",
    "src/test.ts",
    "src/test-unit.ts",
    "src/test-event.ts"
  ]
}
